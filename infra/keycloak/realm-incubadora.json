{
  "realm": "incubadora-universitaria",
  "displayName": "Incubadora universitaria · Arquitectura de Software 1",
  "enabled": true,
  "sslRequired": "none",
  "internationalizationEnabled": true,
  "supportedLocales": [ "es", "en" ],
  "defaultLocale": "es",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "comprador",  "description": "Puede ver catálogos de productos, detalle de un producto y hacer un pedido" },
      { "name": "dueno",  "description": "Puede ver catálogos de productos, detalle de un producto, agregar un producto, editar y eliminar un producto de su tienda" },
      { "name": "admin",  "description": "Puede ver catálogos de productos, detalle de un producto y ver estadísticas" }
    ]
  },
  "users": [
    {
      "id": "11111111-1111-1111-1111-111111111111",
      "username": "ana",
      "firstName": "Ana",
      "lastName": "Duenio",
      "email": "ana@incubadora.com.ar",
      "emailVerified": true,
      "enabled": true,
      "credentials": [ { "type": "password", "value": "ana123", "temporary": false } ],
      "realmRoles": [ "dueno" ]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "carla",
      "firstName": "Carla",
      "lastName": "Duena",
      "email": "carla@incubadora.com.ar",
      "emailVerified": true,
      "enabled": true,
      "credentials": [ { "type": "password", "value": "carla123", "temporary": false } ],
      "realmRoles": [ "dueno" ]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "beto",
      "firstName": "Beto",
      "lastName": "Comprador",
      "email": "beto@incubadora.com.ar",
      "emailVerified": true,
      "enabled": true,
      "credentials": [ { "type": "password", "value": "beto123", "temporary": false } ],
      "realmRoles": [ "comprador" ]
    },
    {
      "id": "44444444-4444-4444-4444-444444444444",
      "username": "admin",
      "firstName": "Admin",
      "lastName": "Administrador",
      "email": "admin@incubadora.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [ { "type": "password", "value": "admin123", "temporary": false } ],
      "realmRoles": [ "admin" ]
    }
  ],
  "clients": [
    {
      "clientId": "swagger-ui",
      "name": "Swagger UI (cliente público)",
      "description": "Corre en el navegador: no puede guardar un secreto. Usa Authorization Code + PKCE.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "http://localhost:8080/oauth2-redirect.html" ],
      "webOrigins": [ "http://localhost:8080" ],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:8080/" },
      "protocolMappers": [
        {
          "name": "audiencia-api-incubadora",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api-incubadora",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "web-incubadora",
      "name": "Web de la incubadora",
      "description": "La web de la incubadora universitaria, que corre en el navegador y llama a la API.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect", 
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "http://localhost:3000/" ],
      "webOrigins": [ "http://localhost:3000" ],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:3000/" },
      "protocolMappers": [
        {
          "name": "audiencia-api-incubadora",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api-incubadora",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
